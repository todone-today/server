# Postgres. `docker compose up db` serves this one; on Vercel, add Neon from the Marketplace.
DATABASE_URL=postgres://todone:todone@localhost:54329/todone
# Any long random string: openssl rand -hex 32
BETTER_AUTH_SECRET=
# The web app's public address: people sign in through it (it forwards /api to this server).
BETTER_AUTH_URL=http://localhost:3000
# Optional: other web app addresses allowed to use this server, comma-separated (e.g. a preview).
BETTER_AUTH_TRUSTED_ORIGINS=
PORT=4000
# Optional: sign in with Google, and two-way Google Calendar. Enable the Google Calendar API, create an OAuth client
# (Web application), redirect URL <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: sign in with GitHub and Discord. Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and
# .../callback/discord. People who sign in this way choose an unlock passphrase for their encrypted lists.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: email through Resend (resend.com) for confirming new accounts and resetting passwords. Without it
# there's no email: sign-up needs no confirmation and "Forgot password?" is hidden. EMAIL_FROM must be on a domain
# verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=todone <hello@todone.today>
# Optional: error reports to Sentry (sentry.io → project → Settings → Client Keys). Nothing personal is sent.
SENTRY_DSN=
# Optional: task attachments and shared-task media, in a Cloudflare R2 bucket (R2 → Manage API tokens → Object
# Read & Write, scoped to the bucket). Without these, attachments are off. The bucket's CORS must allow PUT and GET
# from the website's origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=todone-files
# Protects /api/cron/notify, which sends due reminders; call it every few minutes with
# "Authorization: Bearer $CRON_SECRET" (Vercel Cron does this itself).
CRON_SECRET=
# Docker Compose on a server: the Postgres password, and a Cloudflare Tunnel token to publish the app
# (start with `docker compose --profile tunnel up -d`).
POSTGRES_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=
# The API on its own HTTPS address (the caddy service), with the web app hosted elsewhere: the address, and a
# long random string the web app sends with every request (set the same PROXY_SECRET on the web app).
API_DOMAIN=
PROXY_SECRET=
# Optional: paid plans through Razorpay (actions/billing.ts). Without the keys AND a launch date there are no plans and no
# limits (self-hosting). Accounts made before BILLING_START keep everything free. In the Razorpay dashboard, add a
# webhook to <BETTER_AUTH_URL>/api/billing/webhook with its secret below, for these events: subscription.authenticated,
# subscription.activated, subscription.charged, subscription.pending, subscription.halted, subscription.cancelled,
# subscription.completed, order.paid, refund.processed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_START=
# Optional: who the receipts are from. With a GSTIN, receipts become tax invoices showing the 18% GST included.
BILLING_NAME=
BILLING_ADDRESS=
BILLING_GSTIN=

# Optional: the email of the account that maintains todone. Its app files what people send from "Send feedback" into
# three lists (Bug reports, Suggestions, Other feedback) as tasks. Only once that account's email is confirmed.
FEEDBACK_TO=

# Ask todone (actions/ai.ts): typed or spoken plans become lists, goals and rewards. Off without a Gemini key.
# Use a key on the paid tier: free-tier requests may be used to improve Google's products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK=gemini-3.5-flash-lite (tried when the main model is busy)
# The transcriber's token (worker/README.md), at least 32 characters: openssl rand -hex 32
AI_WORKER_TOKEN=
