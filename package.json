{
  "name": "@todone/server",
  "version": "0.2.0",
  "description": "todone's API: accounts and teams (Better Auth), lists, integrations, push reminders and the public calendar and Markdown links.",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch src/main.ts",
    "local": "pglite-server -d .pglite -p 54329 -m 10 --include-database-url -r \"npm run local:app\"",
    "local:app": "npm run db:migrate && npm run dev",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "start": "node src/main.ts",
    "test": "node --test src/**/*.test.ts",
    "typecheck": "tsc",
    "vercel-build": "node scripts/vercel-build.ts",
    "feedback": "node --env-file-if-exists=.env.local scripts/feedback.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@sentry/node": "^10.78.0",
    "@todone/sdk": "github:todone-today/sdk#v0.8.0",
    "@vercel/functions": "^3.10.6",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.14",
    "hono": "^4.13.16",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todone-today/server.git"
  }
}
